{
  "name": "golsky",
  "main": "worker.js",
  "compatibility_date": "2026-11-23",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GOLSKY_CONTROL",
        "class_name": "GolskyControl"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GolskyControl"
      ]
    }
  ]
}
